# Postgres (usado pelo apps/api / Prisma)
DATABASE_URL="postgresql://dashboard:dashboard@localhost:5432/dashboard?schema=public"

# Redis (cache, filas BullMQ, pub/sub do WebSocket)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3333
NODE_ENV=development

# Auth (Passo 2) — troque os segredos em produção
JWT_ACCESS_SECRET="dev-access-secret-troque-em-prod"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-prod"
JWT_REFRESH_TTL_DAYS=30
TOTP_ISSUER="Dashboard"

# Criptografia AES-256-GCM de dados sensíveis (segredo TOTP, credenciais)
ENCRYPTION_KEY="dev-encryption-key-troque-em-prod"
